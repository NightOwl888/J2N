<!--
  ==================================================================================================
  J2N Text Code Generator - MSBuild Integration Targets
  ==================================================================================================
  
  BACKGROUND:
    This file wires up an external console-based code generator (J2N.Text.CodeGen) into the build 
    pipeline. The generated source files are committed directly to the repository to allow human review 
    of public API surfaces and documentation diffs.

  WHY THIS APPROACH (AVOIDING CROSS-TARGETING HOOKS):
    Standard multi-targeting projects evaluate an outer build followed by inner framework builds. 
    However, IDE build engines like Rider with ReSharper Build optimize compilation by bypassing the 
    outer cross-targeting phase entirely (i.e., `IsCrossTargetingBuild` is never triggered), dropping 
    hooks like `DispatchToInnerBuilds`. 
    
    To ensure this runs reliably across ALL IDEs (Visual Studio, Rider, VS Code) and command-line 
    builds (`dotnet build`) without requiring IDE-specific settings, this target hooks into 
    `BeforeTargets="BeforeCompile"`.

  HOW THE MULTI-TARGETING RACE CONDITION IS SOLVED:
    Because multi-targeting builds compile multiple frameworks in parallel or sequence (e.g., net9.0, 
    net8.0, netstandard2.1), running a global code generator on every framework build would cause 
    redundant execution and file-writing conflicts. 
    
    This is safely resolved via MSBuild's native incremental timestamp engine (`Inputs` and `Outputs`):
    
    1. FIRST FRAMEWORK EXECUTION: When the very first target framework starts compiling, MSBuild 
       compares the modification dates of `@(CodeGenInputs)` against the stamp file 
       (`$(CodeGenOutputStamp)`). If an input file changed (or the stamp is missing), the console 
       app executes, writes the code to disk, and updates the stamp file's timestamp via `<Touch />`.
       
    2. SUBSEQUENT FRAMEWORKS IGNORED: When subsequent target frameworks immediately begin compiling, 
       MSBuild checks the stamp file again. Because the stamp file's timestamp is now newer than 
       the inputs, MSBuild recognizes the output is up-to-date and completely IGNORES/SKIPS the 
       code generator target.
       
  WARNING: 
    Do not add cross-targeting property guards (`IsCrossTargetingBuild`) back to these targets, as 
    ReSharper Build / Rider will silently skip code generation entirely.
  ==================================================================================================
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <CodeGenProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../eng/J2N.Text.CodeGen/J2N.Text.CodeGen.csproj'))</CodeGenProject>
        <CodeGenAssembly>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../eng/J2N.Text.CodeGen/bin/$(Configuration)/net10.0/J2N.Text.CodeGen.dll'))</CodeGenAssembly>
        <CodeGenOutputStamp>$(MSBuildProjectExtensionsPath)J2N.Text.CodeGen.stamp</CodeGenOutputStamp>
    </PropertyGroup>

    <ItemGroup>
        <CodeGenInputs Include="$(MSBuildProjectDirectory)/Text/MutableTextBuffer*.cs" />
        <CodeGenInputs Include="$(MSBuildProjectDirectory)/MutableTextBufferExtensions*.cs" />
        <CodeGenInputs Include="$(MSBuildProjectDirectory)/CodeGeneration/**/*.cs" />
        <CodeGenInputs Include="$(MSBuildThisFileDirectory)../../eng/J2N.Text.CodeGen/**/*.cs" Exclude="**/bin/**;**/obj/**" />
    </ItemGroup>

    <ItemGroup>
        <GeneratedCode Include="$(MSBuildProjectDirectory)/Text/*.generated.cs" />
    </ItemGroup>

    <!-- Force code gen if any expected generated file was deleted from disk -->
    <Target Name="ForceCodeGenIfOutputsMissing"
            BeforeTargets="RunTextCodeGen">
        <ItemGroup>
            <MissingCodeGenOutputs Include="@(GeneratedCode)" Condition="!Exists('%(Identity)')" />
        </ItemGroup>

        <Delete Files="$(CodeGenOutputStamp)" Condition="'@(MissingCodeGenOutputs)' != ''" />
    </Target>

    <!-- Runs before Roslyn compilation (BeforeCompile) -->
    <Target Name="RunTextCodeGen"
            BeforeTargets="BeforeCompile"
            Inputs="@(CodeGenInputs)"
            Outputs="$(CodeGenOutputStamp)">

        <Message Importance="high" Text="Running J2N.Text.CodeGen..." />

        <MSBuild Projects="$(CodeGenProject)"
                 Targets="Build"
                 RemoveProperties="TargetFramework;TargetFrameworks"
                 Properties="Configuration=$(Configuration)" />

        <Exec Command='dotnet "$(CodeGenAssembly)" --j2n-source-directory "$(MSBuildProjectDirectory)" --source-directory "$(MSBuildProjectDirectory)/Text" --infrastructure-directory "$(MSBuildProjectDirectory)/CodeGeneration"' />

        <Touch Files="$(CodeGenOutputStamp)" AlwaysCreate="true" />
    </Target>

</Project>